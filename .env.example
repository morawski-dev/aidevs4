# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.

# OpenRouter — OpenAI-compatible gateway to many models.
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# AI Devs Hub (Centrala) — submit answers, download task data.
# Get from the top of: https://hub.ag3nts.org
AIDEVS_API_KEY=REPLACE_ME

# Langfuse Cloud — OTLP endpoint for traces.
# Endpoint stays the same for cloud.langfuse.com; EU instance: https://cloud.langfuse.com/api/public/otel
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel

# Langfuse Authorization header value. Build from your public + secret keys:
#   $b64 = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("pk-lf-xxx:sk-lf-yyy"))
#   "Basic $b64"
LANGFUSE_AUTH_HEADER=Basic REPLACE_ME_BASE64

PROXY_URL=REPLACE_ME

NEGOTIATIONS_URL=REPLACE_ME